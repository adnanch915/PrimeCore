<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>PrimeCore — Fintech & Asset Portal</title>
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
    body { background: #f1f5f9; color: #0f172a; min-height: 100vh; }
    .topbar { background: linear-gradient(135deg, #1e1b4b 0%, #312e81 100%); color: #ffffff; padding: 15px 20px; display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; box-shadow: 0 2px 12px rgba(15, 23, 42, 0.14); }
    .brand-wrap { display: flex; align-items: center; gap: 10px; }
    .brand { font-size: 20px; font-weight: 800; letter-spacing: 0.3px; }
    .badge { background: rgba(167, 139, 250, 0.22); color: #ede9fe; border: 1px solid rgba(196, 181, 253, 0.35); font-size: 11px; font-weight: 700; padding: 3px 9px; border-radius: 999px; }
    .btn { background: #7c3aed; color: #ffffff; border: none; border-radius: 9px; padding: 10px 15px; font-weight: 600; cursor: pointer; transition: background 0.15s ease, opacity 0.15s ease; }
    .btn:hover { background: #6d28d9; }
    .btn:disabled { opacity: 0.65; cursor: not-allowed; }
    .btn-light { background: #ffffff; color: #1e1b4b; }
    .btn-light:hover { background: #f8fafc; }
    .tabs { background: #1e1b4b; padding: 0 20px 13px; display: flex; gap: 8px; overflow-x: auto; border-bottom: 1px solid rgba(255, 255, 255, 0.08); }
    .tab { background: rgba(255, 255, 255, 0.06); color: #cbd5e1; border: none; padding: 8px 15px; border-radius: 999px; cursor: pointer; font-weight: 600; font-size: 13px; white-space: nowrap; }
    .tab.active { background: #8b5cf6; color: #ffffff; }
    .container { max-width: 780px; margin: 26px auto; padding: 0 16px; }
    .card { background: #ffffff; border: 1px solid #e2e8f0; border-radius: 16px; padding: 22px; box-shadow: 0 8px 24px rgba(15, 23, 42, 0.05); margin-bottom: 16px; }
    .card-title { font-size: 22px; font-weight: 700; color: #0f172a; margin-bottom: 6px; }
    .card-sub { color: #64748b; font-size: 14px; margin-bottom: 18px; }
    .field { margin-bottom: 14px; }
    .field label { display: block; font-size: 13px; font-weight: 700; color: #334155; margin-bottom: 6px; }
    .field input { width: 100%; padding: 11px 13px; border: 1px solid #cbd5e1; border-radius: 9px; background: #f8fafc; font-size: 15px; color: #0f172a; }
    .field input:focus { outline: none; border-color: #7c3aed; background: #ffffff; box-shadow: 0 0 0 3px rgba(124, 58, 237, 0.12); }
    .full-btn { width: 100%; padding: 12px; font-size: 15px; margin-top: 4px; }
    .row-links { display: flex; justify-content: space-between; align-items: center; margin-top: 15px; font-size: 14px; gap: 10px; flex-wrap: wrap; }
    .link-btn { background: none; border: none; color: #6d28d9; font-weight: 600; cursor: pointer; font-size: 14px; }
    .link-btn:hover { text-decoration: underline; }
    .grid-2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 14px; }
    .stat-box { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 16px; }
    .stat-label { font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.4px; color: #64748b; }
    .stat-val { font-size: 24px; font-weight: 800; color: #1e1b4b; margin-top: 6px; }
    .msg-err { background: #fef2f2; border: 1px solid #fecaca; color: #b91c1c; font-size: 13px; padding: 10px 12px; border-radius: 9px; margin-top: 12px; word-break: break-word; }
    .msg-ok { background: #f0fdf4; border: 1px solid #bbf7d0; color: #15803d; font-size: 13px; padding: 10px 12px; border-radius: 9px; margin-top: 12px; word-break: break-word; }
    .hidden { display: none !important; }
  </style>
</head>
<body>
  <header class="topbar">
    <div class="brand-wrap">
      <div class="brand">PrimeCore</div>
      <span class="badge">PRO PORTAL</span>
    </div>
    <button id="signOutBtn" class="btn btn-light hidden" type="button">Sign out</button>
  </header>

  <nav id="navTabs" class="tabs hidden">
    <button class="tab active" data-tab="dashboard" type="button">Dashboard</button>
    <button class="tab" data-tab="tasks" type="button">Tasks</button>
    <button class="tab" data-tab="daily-reward" type="button">Daily Reward</button>
    <button class="tab" data-tab="wallet" type="button">Wallet</button>
    <button class="tab" data-tab="invest" type="button">Invest</button>
  </nav>

  <main class="container">
    <div id="loadingView" class="card">Loading PrimeCore workspace...</div>

    <section id="authView" class="card hidden">
      <h2 id="authTitle" class="card-title">Welcome back</h2>
      <p id="authSubtitle" class="card-sub">Sign in to your PrimeCore account.</p>

      <form id="authForm">
        <div id="signupExtraFields" class="hidden">
          <div class="field">
            <label for="fullNameInput">Full Name</label>
            <input id="fullNameInput" type="text" placeholder="MUHAMMAD ADNAN" />
          </div>
          <div class="field">
            <label for="phoneInput">Phone / WhatsApp (Optional)</label>
            <input id="phoneInput" type="text" placeholder="+92 300 0000000" />
          </div>
          <div class="field">
            <label for="referralInput">Referral Code (Optional)</label>
            <input id="referralInput" type="text" placeholder="PRIME-REF" />
          </div>
        </div>
        <div class="field">
          <label for="emailInput">Email</label>
          <input id="emailInput" type="email" required placeholder="you@example.com" />
        </div>
        <div class="field">
          <label for="passwordInput">Password</label>
          <input id="passwordInput" type="password" required placeholder="••••••••" />
        </div>
        <button id="authSubmitBtn" class="btn full-btn" type="submit">Sign in</button>
      </form>

      <div class="row-links">
        <button id="forgotBtn" class="link-btn" type="button">Forgot password?</button>
        <button id="toggleAuthModeBtn" class="link-btn" type="button">Create account</button>
      </div>
      <div id="authMessage"></div>
    </section>

    <section id="appView" class="hidden">
      <div id="tab-dashboard" class="card tab-panel">
        <h2 class="card-title" style="font-size: 20px;">Dashboard</h2>
        <p id="userEmailText" class="card-sub"></p>
        <div class="grid-2">
          <div class="stat-box">
            <div class="stat-label">Available Balance</div>
            <div id="availBalText" class="stat-val">$0.00</div>
          </div>
          <div class="stat-box">
            <div class="stat-label">Pending Balance</div>
            <div id="pendBalText" class="stat-val">$0.00</div>
          </div>
        </div>
      </div>

      <div id="tab-tasks" class="card tab-panel hidden">
        <h2 class="card-title" style="font-size: 20px;">Tasks</h2>
        <p id="tasksInfo" style="color: #475569;">No tasks assigned yet.</p>
      </div>

      <div id="tab-daily-reward" class="card tab-panel hidden">
        <h2 class="card-title" style="font-size: 20px;">Daily Reward</h2>
        <p class="card-sub">Claim your daily check-in reward.</p>
        <button id="claimDailyBtn" class="btn" type="button">Claim Daily Reward ($5.00)</button>
        <div id="rewardMsg"></div>
      </div>

      <div id="tab-wallet" class="card tab-panel hidden">
        <h2 class="card-title" style="font-size: 20px;">Wallet</h2>
        <p id="walletDetailText" style="color: #475569; font-weight: 600;">Available: $0.00 | Pending: $0.00</p>
      </div>

      <div id="tab-invest" class="card tab-panel hidden">
        <h2 class="card-title" style="font-size: 20px;">Invest</h2>
        <p style="color: #475569;">Starter and growth investment plans will appear here.</p>
      </div>
    </section>
  </main>

  <script>
    const SUPABASE_URL = "https://qufxjfntdqhympultbx.supabase.co";
    const SUPABASE_KEY = "sb_publishable_639f9uEApKsGgOtQW_J9Jg_M-nnwtnB";
    const sb = window.supabase ? window.supabase.createClient(SUPABASE_URL, SUPABASE_KEY) : null;

    let isSignUp = false;

    const loadingView = document.getElementById("loadingView");
    const authView = document.getElementById("authView");
    const appView = document.getElementById("appView");
    const navTabs = document.getElementById("navTabs");
    const signOutBtn = document.getElementById("signOutBtn");
    const authMessage = document.getElementById("authMessage");
    const authSubmitBtn = document.getElementById("authSubmitBtn");

    function showLoading() {
      loadingView.classList.remove("hidden");
      authView.classList.add("hidden");
      appView.classList.add("hidden");
      navTabs.classList.add("hidden");
      signOutBtn.classList.add("hidden");
    }

    function showAuth() {
      loadingView.classList.add("hidden");
      appView.classList.add("hidden");
      navTabs.classList.add("hidden");
      signOutBtn.classList.add("hidden");
      authView.classList.remove("hidden");
    }

    function showApp() {
      loadingView.classList.add("hidden");
      authView.classList.add("hidden");
      appView.classList.remove("hidden");
      navTabs.classList.remove("hidden");
      signOutBtn.classList.remove("hidden");
    }

    async function loadUserData(user) {
      document.getElementById("userEmailText").textContent = "Signed in as: " + (user.email || "");
      if (!sb) return;
      try {
        const { data: wallet } = await sb
          .from("wallet_balances")
          .select("available_balance, pending_balance")
          .eq("user_id", user.id)
          .maybeSingle();

        const avail = Number(wallet?.available_balance ?? 0).toFixed(2);
        const pend = Number(wallet?.pending_balance ?? 0).toFixed(2);

        document.getElementById("availBalText").textContent = "$" + avail;
        document.getElementById("pendBalText").textContent = "$" + pend;
        document.getElementById("walletDetailText").textContent =
          "Available: $" + avail + " | Pending: $" + pend;

        const { data: tasks } = await sb
          .from("tasks")
          .select("id, title, status")
          .eq("user_id", user.id);

        document.getElementById("tasksInfo").textContent =
          tasks && tasks.length > 0
            ? tasks.map(t => `${t.title} (${t.status})`).join(", ")
            : "No tasks assigned yet.";
      } catch (err) {
        console.error("Data load warning:", err);
      }
    }

    async function syncSession() {
      showLoading();
      if (!sb) {
        showAuth();
        return;
      }
      try {
        const { data: { session }, error } = await sb.auth.getSession();
        if (error || !session || !session.user) {
          showAuth();
          return;
        }
        await loadUserData(session.user);
        showApp();
      } catch (err) {
        console.error("Session sync error:", err);
        showAuth();
      }
    }

    document.getElementById("toggleAuthModeBtn").addEventListener("click", () => {
      isSignUp = !isSignUp;
      authMessage.innerHTML = "";
      document.getElementById("signupExtraFields").classList.toggle("hidden", !isSignUp);
      document.getElementById("authTitle").textContent = isSignUp ? "Create account" : "Welcome back";
      document.getElementById("authSubtitle").textContent = isSignUp
        ? "Register your new PrimeCore account."
        : "Sign in to your PrimeCore account.";
      authSubmitBtn.textContent = isSignUp ? "Create account" : "Sign in";
      document.getElementById("toggleAuthModeBtn").textContent = isSignUp
        ? "Already have an account? Sign in"
        : "Create account";
    });

    document.getElementById("authForm").addEventListener("submit", async (e) => {
      e.preventDefault();
      authMessage.innerHTML = "";
      const email = document.getElementById("emailInput").value.trim();
      const password = document.getElementById("passwordInput").value;
      const fullName = document.getElementById("fullNameInput").value.trim();
      const phone = document.getElementById("phoneInput").value.trim();
      const referral = document.getElementById("referralInput").value.trim();

      authSubmitBtn.disabled = true;
      const prevLabel = authSubmitBtn.textContent;
      authSubmitBtn.textContent = isSignUp ? "Creating account..." : "Signing in...";

      try {
        if (isSignUp) {
          const { data, error } = await sb.auth.signUp({
            email,
            password,
            options: {
              data: {
                full_name: fullName || "User",
                phone: phone || null,
                referral_code: referral || null
              },
              emailRedirectTo: "https://primecoreuk.vercel.app"
            }
          });
          if (error) {
            authMessage.innerHTML = `<div class="msg-err">${error.message}</div>`;
            return;
          }
          if (data?.session?.user) {
            await loadUserData(data.session.user);
            showApp();
            return;
          }
          authMessage.innerHTML = `<div class="msg-ok">Account created! Aap ab sign in kar sakte hain.</div>`;
        } else {
          const { data, error } = await sb.auth.signInWithPassword({ email, password });
          if (error) {
            authMessage.innerHTML = `<div class="msg-err">${error.message}</div>`;
            return;
          }
          if (data?.user) {
            await loadUserData(data.user);
            showApp();
          }
        }
      } catch (netErr) {
        authMessage.innerHTML = `<div class="msg-err">Connection Error: ${netErr?.message || netErr}</div>`;
      } finally {
        authSubmitBtn.disabled = false;
        authSubmitBtn.textContent = prevLabel;
      }
    });

    document.getElementById("forgotBtn").addEventListener("click", async () => {
      const email = document.getElementById("emailInput").value.trim();
      if (!email) {
        authMessage.innerHTML = `<div class="msg-err">Enter your email first to reset password.</div>`;
        return;
      }
      try {
        const { error } = await sb.auth.resetPasswordForEmail(email, {
          redirectTo: "https://primecoreuk.vercel.app"
        });
        authMessage.innerHTML = error
          ? `<div class="msg-err">${error.message}</div>`
          : `<div class="msg-ok">Password reset link sent to ${email}.</div>`;
      } catch (err) {
        authMessage.innerHTML = `<div class="msg-err">Connection Error: ${err?.message || err}</div>`;
      }
    });

    signOutBtn.addEventListener("click", async () => {
      if (sb) await sb.auth.signOut();
      showAuth();
    });

    document.querySelectorAll(".tab").forEach((btn) => {
      btn.addEventListener("click", () => {
        document.querySelectorAll(".tab").forEach((t) => t.classList.remove("active"));
        btn.classList.add("active");
        const target = btn.getAttribute("data-tab");
        document.querySelectorAll(".tab-panel").forEach((p) => p.classList.add("hidden"));
        document.getElementById("tab-" + target)?.classList.remove("hidden");
      });
    });

    document.getElementById("claimDailyBtn").addEventListener("click", async () => {
      const rewardMsg = document.getElementById("rewardMsg");
      rewardMsg.innerHTML = "";
      if (!sb) return;
      const { data: { user } } = await sb.auth.getUser();
      if (!user) return;
      const { error } = await sb.from("daily_rewards").insert({
        user_id: user.id,
        reward_amount: 5.00
      });
      if (error) {
        rewardMsg.innerHTML = `<div class="msg-err">${error.message}</div>`;
        return;
      }
      rewardMsg.innerHTML = `<div class="msg-ok">Daily reward of $5.00 recorded!</div>`;
    });

    if (sb) {
      sb.auth.onAuthStateChange(async (event, session) => {
        if (event === "SIGNED_OUT" || !session?.user) {
          showAuth();
        } else if (event === "SIGNED_IN" || event === "TOKEN_REFRESHED") {
          await loadUserData(session.user);
          showApp();
        }
      });
    }

    syncSession();
  </script>
</body>
</html>
